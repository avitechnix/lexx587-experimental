[Unit]
Description=ffagent: ESPN fantasy football agent (injury watch)
Documentation=https://github.com/avitechnix/lexx587-experimental/tree/main/ffagent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=ffagent
Group=ffagent
EnvironmentFile=/etc/ffagent/watch.env
Environment=HOME=/var/lib/ffagent
Environment=FFAGENT_CONFIG=/etc/ffagent/config.json
Environment=FFAGENT_VAULT=/var/lib/ffagent/secrets.vault
ExecStart=/usr/local/bin/ffagent watch $FFAGENT_WATCH_FLAGS
Restart=on-failure
RestartSec=2min

# The vault passphrase is an encrypted credential (TPM2-bound where
# available); systemd decrypts it for this service only, into a private
# in-memory directory exposed as $CREDENTIALS_DIRECTORY.
LoadCredentialEncrypted=ffagent-passphrase:/etc/credstore.encrypted/ffagent-passphrase

# Never write credentials to core dumps.
LimitCORE=0

# Sandboxing: the agent only needs outbound HTTPS and its state directory.
StateDirectory=ffagent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
